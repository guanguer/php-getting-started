{% extends "layout.html" %}

{% block content %}
<div class="container">
  <div class="lead">
    Got these books from our bookshelf
    <ul>
    {% for book in books %}
      <li>
        <p> Title: {{ book.title }} </p>
        <p> Author: {{ book.author }} </p>
        <p> Abstract: {{ book.description }} </p>
        <p> Number of Pages: {{ book.pages }} </p>
      </li>
    {% else %}
      <li><em>No books yet</em></li>
    {% endfor %}
    </ul>
  </div>
</div>
{% endblock %}
